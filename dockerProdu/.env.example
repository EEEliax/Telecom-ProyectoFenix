# Copiá este archivo a ".env" (mismo directorio) y completá los valores.

# --- Postgres (contenedor local) ---
POSTGRES_USER=fenix_admin
POSTGRES_PASSWORD=cambiar_por_una_password_local
POSTGRES_DB=conectamax_fenix

# --- Backend ---
# Generar con: openssl rand -hex 32
JWT_SECRET=cambiar_por_un_secreto_random

# --- n8n ---
# Generar con: openssl rand -hex 16
# Importante: usar siempre la misma clave. Si cambia con el volumen n8n_data ya
# creado, n8n no arranca ("Mismatching encryption keys").
N8N_ENCRYPTION_KEY=cambiar_por_un_string_random_de_32_caracteres
