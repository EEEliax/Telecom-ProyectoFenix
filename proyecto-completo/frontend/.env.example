# En desarrollo NO hace falta nada acá — el proxy de Vite (ver vite.config.js)
# redirige /api y /socket.io hacia el backend en localhost:3001 automáticamente.
#
# Esta variable se usa recién al hacer un build de producción, donde ya no
# existe el proxy de desarrollo y el frontend necesita saber la URL real del
# backend desplegado.
# VITE_API_BASE_URL=https://tu-backend-en-produccion.com
